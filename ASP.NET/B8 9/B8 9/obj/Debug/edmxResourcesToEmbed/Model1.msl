<?xml version="1.0" encoding="utf-8"?>
<Mapping Space="C-S" xmlns="http://schemas.microsoft.com/ado/2009/11/mapping/cs">
  <EntityContainerMapping StorageEntityContainer="WineStoreModelStoreContainer" CdmEntityContainer="WineStoreEntities">
    <EntitySetMapping Name="Catalogies">
      <EntityTypeMapping TypeName="WineStoreModel.Catalogy">
        <MappingFragment StoreEntitySet="Catalogy">
          <ScalarProperty Name="CatalogyID" ColumnName="CatalogyID" />
          <ScalarProperty Name="CatalogyName" ColumnName="CatalogyName" />
          <ScalarProperty Name="Description" ColumnName="Description" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="Products">
      <EntityTypeMapping TypeName="WineStoreModel.Product">
        <MappingFragment StoreEntitySet="Product">
          <ScalarProperty Name="ProductID" ColumnName="ProductID" />
          <ScalarProperty Name="ProductName" ColumnName="ProductName" />
          <ScalarProperty Name="Description" ColumnName="Description" />
          <ScalarProperty Name="PurchasePrice" ColumnName="PurchasePrice" />
          <ScalarProperty Name="Price" ColumnName="Price" />
          <ScalarProperty Name="Quantity" ColumnName="Quantity" />
          <ScalarProperty Name="Vintage" ColumnName="Vintage" />
          <ScalarProperty Name="CatalogyID" ColumnName="CatalogyID" />
          <ScalarProperty Name="Image" ColumnName="Image" />
          <ScalarProperty Name="Region" ColumnName="Region" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
  </EntityContainerMapping>
</Mapping>