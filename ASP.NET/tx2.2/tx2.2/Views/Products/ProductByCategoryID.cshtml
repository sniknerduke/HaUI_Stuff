@model IEnumerable<tx2._2.Models.Product>

@{
    ViewBag.Title = "Sản phẩm theo danh mục";
}

<h2 class="alert alert-success">Danh mục sản phẩm: @ViewBag.CategoryName</h2>

<p>
    @Html.ActionLink("Quay lại danh sách tổng", "Index", null, new { @class = "btn btn-default" })
</p>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-sm-6 col-md-4 col-lg-3 text-center" style="margin-bottom: 20px;">
            <div style="border: 1px solid #ddd; padding: 10px; border-radius: 4px;">
                <a href="@Url.Action("Details", "Products", new { id = item.Pid })">
                    <img src="@Url.Content("~/Content/Images/" + (item.ImagePath ?? "no-image-news.png"))" width="150" height="150" />
                </a>
                <br />
                Mã sản phẩm: <b>@item.Pid</b><br />
                Tên sản phẩm: <b>@item.ProdName</b><br />
                Mô tả: <b>@item.Description</b><br />
                Giá tiền: <b class="text-danger">@item.Price VNĐ</b><br />
            </div>
        </div>
    }
</div>
