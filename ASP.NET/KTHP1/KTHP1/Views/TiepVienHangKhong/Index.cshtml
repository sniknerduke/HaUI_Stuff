@model IEnumerable<KTHP1.Models.TiepVien>

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "ThemTiepVien", null, new { @class = "btn btn-success" })
</p>

@using (Html.BeginForm("Index", "TiepVienHangKhong", FormMethod.Get, new { @class = "mb-4" }))
{
    <div class="row align-items-center bg-light p-3 border rounded g-3">
        <div class="col-md-3">
            <label class="form-label font-weight-bold">Họ tên tiếp viên</label>
            <input type="text" name="hoTen" class="form-control" placeholder="Tìm theo tên..." value="@ViewBag.CurrentHoTen" />
        </div>
        <div class="col-md-3">
            <label class="form-label font-weight-bold">Bộ phận</label>
            @Html.DropDownList("maBP", (SelectList)ViewBag.MaBoPhan, "--- Tất cả bộ phận ---", new { @class = "form-select" })
        </div>
        <div class="col-md-3">
            <label class="form-label font-weight-bold">Số chuyến tối thiểu</label>
            <input type="number" name="soChuyenBayMin" class="form-control" placeholder="Nhập số chuyến..." value="@ViewBag.CurrentSoChuyenBayMin" />
        </div>
        <div class="col-md-3 mt-4 text-end">
            <button type="submit" class="btn btn-primary w-100 mt-2">Tìm kiếm</button>
        </div>
    </div>
}

<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Anh)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.BoPhan.TenBoPhan)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.MatKhau)
        </th>   
        <th>
            @Html.DisplayNameFor(model => model.HoTen)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.NgaySinh)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Luong)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.SoLuongChuyenBay)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @if (!string.IsNullOrEmpty(item.Anh))
            {
                <img src="~/Content/Images/@item.Anh" alt="Ảnh tiếp viên" style="width: 50px; height: 50px; object-fit: cover; border-radius: 5px; border: 1px solid #ddd;" />
            }
            else
            {
                <span class="text-muted">Không có ảnh</span>
            }
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.BoPhan.TenBoPhan)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.MatKhau)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.HoTen)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.NgaySinh)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Luong)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.SoLuongChuyenBay)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id=item.MaTV }) |
            @Html.ActionLink("Details", "Details", new { id=item.MaTV }) |
            @Html.ActionLink("Delete", "Delete", new { id=item.MaTV })
        </td>
    </tr>
}

</table>
