<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <style>
        body {
            font-family: calibri, sans-serif;
            background-color: #c3c3c3;
            margin: 0;
            padding: 30px;
        }

        .container {
            background-color: white;
            width: 80%;
            margin: 0 auto;
            min-height: 500px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }

        .header {
            background-color: #00a2e8;
            color: white;
            text-align: center;
            padding: 30px;
            font-size: 32px;
        }

        .menu {
            background-color: #99d9ea;
            padding: 10px;
            text-align: center;
        }

            .menu a {
                color: black;
                text-decoration: none;
                margin: 0 50px;
            }

        .content {
            padding: 20px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            Kiểm tra 1
        </div>
        <div class="menu">
            @Html.ActionLink("Hiển thị danh sách", "HienThiDS", "QuanLyNV") |
            @Html.ActionLink("Nhập dữ liệu", "NhapDL", "QuanLyNV")
        </div>
        <div class="content">
            @RenderBody()
        </div>
    </div>
</body>
</html>