<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Kiem Tra ASP.NET</title>
    <style>
        body {
            font-family: calibri, sans-serif; /* Câu 6: Font chữ calibri */
            background-color: #c3c3c3; /* Câu 6: Màu xám nền */
            margin: 0;
            padding: 30px;
        }

        .container {
            background-color: white;
            width: 80%;
            margin: 0 auto;
            min-height: 500px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }

        .header {
            background-color: #3f48cc; /* Câu 6: Màu xanh banner */
            color: white;
            text-align: center;
            padding: 30px;
            font-size: 28px;
        }

        .menu {
            background-color: #6871d7; /* Câu 6: Màu xanh link */
            padding: 10px;
            text-align: right; /* Căn lề phải cho giống ảnh mẫu */
            padding-right: 20px;
        }

            .menu a {
                color: white;
                text-decoration: none;
                margin-left: 30px;
                font-weight: bold;
            }

                .menu a:hover {
                    text-decoration: underline;
                }

        .content {
            padding: 20px;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            KIỂM TRA 1 - ASP.NET
        </div>

        <div class="menu">
            @Html.ActionLink("Thêm sản phẩm", "ThemSanPham", "Sanpham") |
            @Html.ActionLink("Hiển thị danh sách", "HienThiDanhSach", "Sanpham")
        </div>

        <div class="content">
            @RenderBody()
        </div>
    </div>
</body>
</html>